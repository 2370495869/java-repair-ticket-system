# Copy this file to .env for local Docker Compose use. Keep .env private.
POSTGRES_DB=repair_tickets
POSTGRES_USER=repair
POSTGRES_PASSWORD=
APP_PORT=8080

# Leave blank to generate random demo passwords in the application startup log.
REPAIR_DEMO_ENABLED=true
REPAIR_DEMO_CUSTOMER_PASSWORD=
REPAIR_DEMO_SUPPORT_PASSWORD=
REPAIR_DEMO_TECHNICIAN_PASSWORD=

# Keep false for localhost HTTP. Set true behind HTTPS in a real deployment.
SESSION_COOKIE_SECURE=false
